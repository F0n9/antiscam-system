# PostgreSQL
POSTGRES_USER=antiscam_admin
POSTGRES_PASSWORD=antiscam_secret_pass
POSTGRES_DB=antiscam_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://antiscam_admin:antiscam_secret_pass@localhost:5432/antiscam_db

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=antiscam_neo4j_pass
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# FastAPI
APP_ENV=development
API_V1_STR=/api/v1
SECRET_KEY=generate_a_random_secret_key_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Firebase
FIREBASE_CREDENTIALS_PATH=./app/core/firebase-service-account.json

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAP_API_KEY=your_map_api_key_here
